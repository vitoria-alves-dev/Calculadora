<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Calculadora.Mobile.ViewModels"
             x:Class="Calculadora.Mobile.MainPage"
             Title="Simulador de Recebíveis"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0B0F17}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="16,14,16,36">

            <!-- 1. CABEÇALHO HERO COM IDENTIDADE VISUAL FINTECH -->
            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    Padding="20,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4338CA" Offset="0.0" />
                        <GradientStop Color="#6366F1" Offset="0.6" />
                        <GradientStop Color="#7C3AED" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="#33FFFFFF"
                                StrokeThickness="0"
                                Padding="8,4">
                            <Label Text="💳 FINTECH MOBILE"
                                   TextColor="White"
                                   FontSize="11"
                                   FontAttributes="Bold" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="#22FFFFFF"
                                StrokeThickness="0"
                                Padding="8,4">
                            <Label Text=".NET MAUI 9"
                                   TextColor="#E0E7FF"
                                   FontSize="11" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="Simulador de Antecipação"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label Text="Calcule MDR, taxas proporcionais e antecipação com precisão bancária"
                           FontSize="12"
                           TextColor="#E0E7FF" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. SELETOR DE MODALIDADE (SEGMENTED CONTROL / PILLS) -->
            <Border StrokeShape="RoundRectangle 26"
                    BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                    StrokeThickness="0"
                    Padding="4">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <!-- Botão Modo Padrão -->
                    <Button Grid.Column="0"
                            Text="📈 Simulação Padrão"
                            Command="{Binding AlternarModoPadraoCommand}"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="22"
                            HeightRequest="42">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsModoPadrao}" Value="True">
                                <Setter Property="BackgroundColor" Value="#4F46E5" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsModoPadrao}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Botão Modo Reverso -->
                    <Button Grid.Column="1"
                            Text="🔄 Cálculo Reverso"
                            Command="{Binding AlternarModoReversoCommand}"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="22"
                            HeightRequest="42">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsModoReverso}" Value="True">
                                <Setter Property="BackgroundColor" Value="#4F46E5" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsModoReverso}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. FORMULÁRIO DE ENTRADA DE DADOS -->
            <Border StrokeShape="RoundRectangle 18"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161E2E}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#293548}"
                    StrokeThickness="1"
                    Padding="18">
                <VerticalStackLayout Spacing="16">

                    <!-- MENSAGEM EXPLICATIVA DO MODO -->
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            Padding="12,8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsModoPadrao}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEF2FF, Dark=#1E2238}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsModoReverso}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#ECFDF5, Dark=#132B25}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label FontSize="12">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsModoPadrao}" Value="True">
                                    <Setter Property="Text" Value="💡 Modo Simulação: Informe o valor bruto vendido e veja o valor líquido a receber." />
                                    <Setter Property="TextColor" Value="#4F46E5" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsModoReverso}" Value="True">
                                    <Setter Property="Text" Value="🎯 Modo Reverso: Informe o valor líquido que deseja receber para descobrir quanto cobrar." />
                                    <Setter Property="TextColor" Value="#059669" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- CAMPO: VALOR BRUTO (VISÍVEL NO MODO PADRÃO) -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsModoPadrao}">
                        <Label Text="VALOR BRUTO DA VENDA (R$)"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />

                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                Padding="12,2">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="R$"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#4F46E5"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding ValorBrutoTexto}"
                                       Placeholder="ex: 1000,00"
                                       Keyboard="Numeric"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- CAMPO: VALOR LÍQUIDO DESEJADO (VISÍVEL NO MODO REVERSO) -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsModoReverso}">
                        <Label Text="VALOR LÍQUIDO DESEJADO (R$)"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />

                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                Padding="12,2">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="R$"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#059669"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding ValorLiquidoTexto}"
                                       Placeholder="ex: 1000,00"
                                       Keyboard="Numeric"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- CAMPO: BANDEIRA DO CARTÃO -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="BANDEIRA DO CARTÃO"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
                            <Label Grid.Column="1"
                                   Text="Ajusta o MDR sugerido"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                        </Grid>

                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                Padding="10,0">
                            <Picker ItemsSource="{Binding Bandeiras}"
                                    SelectedItem="{Binding BandeiraSelecionada}"
                                    Title="Selecione a Bandeira"
                                    FontSize="14"
                                    TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                    TitleColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- CAMPOS: TAXAS EM GRID DE 2 COLUNAS (MDR e ANTECIPAÇÃO) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Taxa MDR -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="TAXA MDR (%)"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />

                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                    StrokeThickness="1"
                                    Padding="10,2">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Entry Grid.Column="0"
                                           Text="{Binding TaxaMdrTexto}"
                                           Placeholder="2,19"
                                           Keyboard="Numeric"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                    <Label Grid.Column="1"
                                           Text="%"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Taxa de Antecipação -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="ANTECIPAÇÃO (% a.m.)"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />

                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                    StrokeThickness="1"
                                    Padding="10,2">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Entry Grid.Column="0"
                                           Text="{Binding TaxaAntecipacaoTexto}"
                                           Placeholder="2,10"
                                           Keyboard="Numeric"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                    <Label Grid.Column="1"
                                           Text="% a.m."
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- CAMPO: QUANTIDADE DE PARCELAS COM CONTROLE RÁPIDO -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="QUANTIDADE DE PARCELAS"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#EEF2FF"
                                    StrokeThickness="0"
                                    Padding="8,2">
                                <Label Text="{Binding DescricaoParcelas}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#4F46E5" />
                            </Border>
                        </Grid>

                        <!-- Stepper / Controle Numérico -->
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                Padding="8,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                <Button Grid.Column="0"
                                        Text="-"
                                        Command="{Binding DecrementarParcelasCommand}"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        CornerRadius="10"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                        TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                                <Label Grid.Column="1"
                                       Text="{Binding QuantidadeParcelas, StringFormat='{0}x parcelas'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                                <Button Grid.Column="2"
                                        Text="+"
                                        Command="{Binding IncrementarParcelasCommand}"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        CornerRadius="10"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        BackgroundColor="#4F46E5"
                                        TextColor="White" />
                            </Grid>
                        </Border>

                        <!-- Chips de Seleção Rápida de Parcelas -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="1x" Command="{Binding SelecionarParcelaRapidaCommand}" CommandParameter="1" HeightRequest="32" FontSize="11" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" Padding="10,0"/>
                                <Button Text="2x" Command="{Binding SelecionarParcelaRapidaCommand}" CommandParameter="2" HeightRequest="32" FontSize="11" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" Padding="10,0"/>
                                <Button Text="3x" Command="{Binding SelecionarParcelaRapidaCommand}" CommandParameter="3" HeightRequest="32" FontSize="11" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" Padding="10,0"/>
                                <Button Text="6x" Command="{Binding SelecionarParcelaRapidaCommand}" CommandParameter="6" HeightRequest="32" FontSize="11" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" Padding="10,0"/>
                                <Button Text="10x" Command="{Binding SelecionarParcelaRapidaCommand}" CommandParameter="10" HeightRequest="32" FontSize="11" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" Padding="10,0"/>
                                <Button Text="12x" Command="{Binding SelecionarParcelaRapidaCommand}" CommandParameter="12" HeightRequest="32" FontSize="11" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" Padding="10,0"/>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- CAMPOS: DATAS DA OPERAÇÃO -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <!-- Data da Venda -->
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="DATA DA VENDA"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />

                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                        StrokeThickness="1"
                                        Padding="10,0">
                                    <DatePicker Date="{Binding DataVenda}"
                                                Format="dd/MM/yyyy"
                                                FontSize="13"
                                                TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                                VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Data do Recebimento -->
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="RECEBIMENTO"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />

                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                        StrokeThickness="1"
                                        Padding="10,0">
                                    <DatePicker Date="{Binding DataRecebimento}"
                                                Format="dd/MM/yyyy"
                                                FontSize="13"
                                                TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                                VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Atalhos rápidos de recebimento -->
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                            <Button Text="Hoje (D+0)" Command="{Binding DefinirRecebimentoHojeCommand}" HeightRequest="28" FontSize="10" CornerRadius="6" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E293B}" TextColor="#4F46E5" Padding="8,0"/>
                            <Button Text="Amanhã (D+1)" Command="{Binding DefinirRecebimentoD1Command}" HeightRequest="28" FontSize="10" CornerRadius="6" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E293B}" TextColor="#4F46E5" Padding="8,0"/>
                            <Button Text="30 Dias" Command="{Binding DefinirRecebimentoD30Command}" HeightRequest="28" FontSize="10" CornerRadius="6" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E293B}" TextColor="#4F46E5" Padding="8,0"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- MENSAGEM DE ERRO (CASO HAJA) -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FEF2F2"
                            Stroke="#EF4444"
                            StrokeThickness="1"
                            Padding="12,10"
                            IsVisible="{Binding TemMensagemErro}">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="⚠️" FontSize="14" VerticalOptions="Center"/>
                            <Label Text="{Binding MensagemErro}"
                                   FontSize="12"
                                   TextColor="#B91C1C"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- BOTÃO PRINCIPAL CALCULAR -->
                    <Button Text="⚡ CALCULAR SIMULAÇÃO"
                            Command="{Binding CalcularCommand}"
                            HeightRequest="52"
                            FontSize="15"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            BackgroundColor="#4F46E5"
                            TextColor="White" />

                    <!-- AÇÃO RÁPIDA: PREENCHER COM EXEMPLO DA PLANILHA -->
                    <Button Text="📋 Preencher com exemplo da Planilha (R$ 658,00 • 2x)"
                            Command="{Binding PreencherExemploPlanilhaCommand}"
                            HeightRequest="36"
                            FontSize="11"
                            BackgroundColor="Transparent"
                            TextColor="#6366F1" />

                </VerticalStackLayout>
            </Border>

            <!-- 4. BLOCOS DE DESTAQUE DOS RESULTADOS -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding TemResultado}">

                <Label Text="RESULTADOS CONSOLIDADOS"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"
                       Margin="4,6,0,0" />

                <!-- HERO CARD 1: VALOR LÍQUIDO FINAL / BRUTO REVERSO -->
                <Border StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        Padding="20,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#059669" Offset="0.0" />
                            <GradientStop Color="#10B981" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding TituloDestaquePrincipal}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#D1FAE5"
                                   CharacterSpacing="0.8" />
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#33FFFFFF"
                                    StrokeThickness="0"
                                    Padding="8,2">
                                <Label Text="{Binding PercentualLiquidoFormatado, StringFormat='{0} líquido'}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </Grid>

                        <Label Text="{Binding ValorDestaquePrincipalFormatado}"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label Text="{Binding SubtituloDestaquePrincipal}"
                               FontSize="11"
                               TextColor="#ECFDF5" />
                    </VerticalStackLayout>
                </Border>

                <!-- GRID DE 2 COLUNAS: DESTAQUES DE DESCONTOS (MDR e ANTECIPAÇÃO) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <!-- DESTAQUE 1: DESCONTO MDR -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light=#FFF1F2, Dark=#27151D}"
                            Stroke="#FB7185"
                            StrokeThickness="1"
                            Padding="14,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="(-) DESCONTO MDR"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#E11D48" />

                            <Label Text="{Binding DescontoMdrFormatado}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#BE123C" />

                            <Label Text="Retenção da bandeira"
                                   FontSize="10"
                                   TextColor="#9F1239" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- DESTAQUE 2: DESCONTO ANTECIPAÇÃO -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light=#FFFBEB, Dark=#261E14}"
                            Stroke="#FBBF24"
                            StrokeThickness="1"
                            Padding="14,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="(-) ANTECIPAÇÃO"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#D97706" />

                            <Label Text="{Binding DescontoAntecipacaoFormatado}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#B45309" />

                            <Label Text="Custo dos dias antecipados"
                                   FontSize="10"
                                   TextColor="#92400E" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- RESUMO FINANCEIRO COMPLETO (CET, TOTAL DE TAXAS E DIVISÃO) -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161E2E}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#293548}"
                        StrokeThickness="1"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <!-- Coluna 1: Total Descontos -->
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="TOTAL DESCONTOS" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label Text="{Binding TotalDescontosFormatado}" FontSize="14" FontAttributes="Bold" TextColor="#EF4444" />
                            </VerticalStackLayout>

                            <!-- Coluna 2: CET % -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="CUSTO EFETIVO (CET)" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label Text="{Binding CetFormatado}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </VerticalStackLayout>

                            <!-- Coluna 3: Bruto Total -->
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="VALOR BRUTO" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label Text="{Binding ValorBrutoTotalFormatado}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#293548}" Margin="0,4" />

                        <!-- Resumo das Parcelas -->
                        <Label Text="{Binding ResumoParcelasFormatado}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
                    </VerticalStackLayout>
                </Border>

                <!-- CRONOGRAMA DETALHADO POR PARCELA -->
                <VerticalStackLayout Spacing="8" Margin="0,6,0,0">
                    <Label Text="CRONOGRAMA DETALHADO POR PARCELA"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"
                           Margin="4,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Parcelas}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ParcelaDetalheItem">
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161E2E}"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#293548}"
                                        StrokeThickness="1"
                                        Padding="14,10">
                                    <VerticalStackLayout Spacing="6">
                                        <!-- Topo da Parcela -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding TituloParcela}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                                            <Label Grid.Column="1"
                                                   Text="{Binding ValorLiquidoTexto, StringFormat='Líquido: {0}'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#059669" />
                                        </Grid>

                                        <!-- Informações de Vencimento e Prazo -->
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding VencimentoTexto}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            <Label Text="•" FontSize="11" TextColor="#CBD5E1" />
                                            <Label Text="{Binding DiasAntecipadosTexto}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                        </HorizontalStackLayout>

                                        <!-- Linha de Valores Financeiros da Parcela -->
                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Margin="0,4,0,0">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="Bruto" FontSize="9" TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                                                <Label Text="{Binding ValorBrutoTexto}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="MDR" FontSize="9" TextColor="#FB7185" />
                                                <Label Text="{Binding DescontoMdrTexto}" FontSize="11" FontAttributes="Bold" TextColor="#E11D48" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="2">
                                                <Label Text="Antec." FontSize="9" TextColor="#FBBF24" />
                                                <Label Text="{Binding DescontoAntecipacaoTexto}" FontSize="11" FontAttributes="Bold" TextColor="#D97706" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="3">
                                                <Label Text="Tx. Dia" FontSize="9" TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                                                <Label Text="{Binding TaxaDiaTexto}" FontSize="10" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
